# ===========================================
# FinanceTracker Environment Variables
# ===========================================
# Copy this file to ".env" and fill in real values.
# ".env" is already in .gitignore - never commit real secrets.

# ---- Flask ----
FLASK_SECRET_KEY=change-this-to-a-long-random-string

# ---- MySQL ----
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=data
DB_NAME=finance_tracker

# ---- Resend (email) ----
# Get this from https://resend.com/api-keys
# NOTE: Regenerate any key that has ever been shown in a screenshot/screen-share.
RESEND_API_KEY=re_your_api_key_here

# Must be an address on a domain you have verified in Resend,
# OR onboarding@resend.dev for testing (only delivers to your own account email).
RESEND_FROM_EMAIL=onboarding@resend.dev

# ---- OTP / Registration abuse protection ----
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
